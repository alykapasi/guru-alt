# Copy to .env and adjust. All keys are prefixed GURU_.

# App
GURU_ENV=dev            # dev | test | prod
GURU_DEBUG=true
GURU_LOG_LEVEL=INFO
GURU_LOG_JSON=false     # true for JSON logs (prod)

# PostgreSQL (async driver). Host port 5433 — matches docker-compose.yml.
GURU_DATABASE_URL=postgresql+asyncpg://guru:guru@localhost:5433/guru
GURU_DB_ECHO=false

# Redis (used from Phase 4)
GURU_REDIS_URL=redis://localhost:6379/0
