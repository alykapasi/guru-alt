# Copy to .env and adjust: `cp .env.example .env`. All keys are prefixed GURU_.
#
# Every setting has a working dev default (see app/core/config.py), so an unedited copy of
# this file runs the whole stack locally against docker compose + Ollama. Uncomment and edit
# only what you need. Restart `poe dev` AND `poe worker` after changing anything — settings
# are cached per process.

# ─── App ──────────────────────────────────────────────────────────────────────
GURU_ENV=dev            # dev | test | prod  (controls log style + beartype runtime checks)
GURU_DEBUG=true
GURU_LOG_LEVEL=INFO     # DEBUG for verbose tracing
GURU_LOG_JSON=false     # true for JSON logs (prod)

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Async driver. Host port 5433 (not 5432) — matches docker-compose.yml.
GURU_DATABASE_URL=postgresql+asyncpg://guru:guru@localhost:5433/guru
GURU_DB_ECHO=false      # true to log every SQL statement

# ─── Redis (job queue: ingestion, memory write-back) ──────────────────────────
GURU_REDIS_URL=redis://localhost:6379/0

# ─── Object storage (S3-compatible; MinIO in dev) ─────────────────────────────
# Raw uploaded files. Defaults target the docker-compose minio service, whose
# minio-bootstrap sidecar creates the bucket on startup.
GURU_BLOB_ENDPOINT_URL=http://localhost:9000
GURU_BLOB_BUCKET=guru-uploads
GURU_BLOB_ACCESS_KEY=minioadmin
GURU_BLOB_SECRET_KEY=minioadmin
GURU_BLOB_REGION=us-east-1

# ─── CORS ─────────────────────────────────────────────────────────────────────
# JSON array. Dev default is the Vite dev server.
# GURU_CORS_ORIGINS=["http://localhost:5173"]

# ─── Models: roles, not model names ───────────────────────────────────────────
# Code asks for a ROLE; the registry resolves it to "provider:model" from these.
# Providers: ollama (local) | openrouter | anthropic.
# Dev defaults run entirely on Ollama, so nothing here costs money until you
# point a role at a cloud provider.
#
#   ollama pull llama3.2 && ollama pull llama3.2-vision && ollama pull nomic-embed-text
#
GURU_MODEL_FAST=ollama:llama3.2                 # high-volume cheap work (KC tagging, classification)
GURU_MODEL_SMART=ollama:llama3.2                # default tutoring, grading, notes
GURU_MODEL_GENIUS=ollama:llama3.2               # hardest reasoning
GURU_MODEL_VISION=ollama:llama3.2-vision        # MUST be multimodal — OCR of scanned pages/frames
GURU_MODEL_EMBED=ollama:nomic-embed-text        # embeddings

# Embedding dimension MUST match the EMBED model's output (nomic = 768) and the
# pgvector column width. Changing this is a SCHEMA MIGRATION, not just a setting.
GURU_EMBED_DIM=768

# Cloud example — uncomment and set a key to route a role at a hosted model:
# GURU_MODEL_SMART=openrouter:anthropic/claude-sonnet-4-6
# GURU_MODEL_GENIUS=openrouter:anthropic/claude-opus-4-8

# GURU_MODEL_EMBED must name a provider that has an embeddings API (ollama, openrouter).
# Anthropic does not, and the app refuses to start if it is routed there.

# ─── Providers ────────────────────────────────────────────────────────────────
GURU_OLLAMA_BASE_URL=http://localhost:11434/v1
# Transport limits for every provider. The timeout is per network read, not per turn, so a
# long streamed answer is unaffected — it bounds a provider that has stopped responding.
# GURU_LLM_TIMEOUT_SECONDS=60
# GURU_LLM_MAX_RETRIES=2
# GURU_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GURU_OPENROUTER_API_KEY=sk-or-...
# GURU_ANTHROPIC_API_KEY=sk-ant-...

# ─── Ingestion ────────────────────────────────────────────────────────────────
# Uploads stream to disk, so this bounds disk, not RAM. Default 1 GiB.
# GURU_MAX_UPLOAD_BYTES=1073741824
# GURU_INGEST_TMP_DIR=/tmp                      # unset = system default

# Concurrency (DB writes stay serialized regardless; only network/CPU parallelizes).
# GURU_OCR_CONCURRENCY=5
# GURU_EMBED_BATCH_SIZE=128
# GURU_EMBED_CONCURRENCY=4

# Per-chunk KC auto-tagging: drop tags below the confidence floor.
# GURU_KC_TAG_MIN_CONFIDENCE=0.5
# GURU_KC_TAG_CONCURRENCY=5

# Audio/video ASR — needs the extra: `uv sync --extra asr`
# GURU_ASR_MODEL=base                           # tiny | base | small | medium | large-v3
# GURU_ASR_DEVICE=cpu
# GURU_ASR_COMPUTE_TYPE=int8

# Video demux — ffmpeg/ffprobe are SYSTEM tools, not Python deps. Must be on PATH
# (or point these at absolute paths) for video ingestion to work.
# GURU_FFMPEG_BIN=ffmpeg
# GURU_FFPROBE_BIN=ffprobe
# GURU_VIDEO_MAX_KEYFRAMES=20

# ─── Cost/UX bounds ───────────────────────────────────────────────────────────
# These cap worst-case LLM calls per request. Raise them deliberately.
# GURU_CHAT_MAX_TOKENS=2048
# GURU_AGENTIC_MAX_ITERATIONS=4                 # tool-execution rounds per agentic turn
# GURU_REFINEMENT_MAX_ROUNDS=3                  # refinement-gate negotiation rounds
# GURU_WORKFLOW_MAX_ROUNDS=3                    # attempt rounds per guided-practice turn
#
# The remaining tuning knobs (placement test size, profile session gap, memory
# window/dedup/retrieval, lesson-plan caps, review limits, chat grounding, web-fetch
# cap, note distillation caps) are documented inline in app/core/config.py —
# override any of them with GURU_<FIELD_NAME>.
